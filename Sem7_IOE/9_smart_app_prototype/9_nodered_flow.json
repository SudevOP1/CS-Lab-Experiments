    {
        "id": "exp9_func",
        "type": "function",
        "z": "exp9_flow",
        "name": "validate + analyze",
        "func": "// validate + analyze campus readings\nconst LIMITS = { temperature_c: [-10, 60], occupancy: [0, 500], light_lux: [0, 100000] };\nconst MAX_OCCUPANCY = 40;\nconst p = msg.payload;\n\nif (typeof p !== \"object\" || p === null) {\n    node.warn(\"payload is not json\");\n    return null;\n}\nfor (const [field, [low, high]] of Object.entries(LIMITS)) {\n    const v = p[field];\n    if (typeof v !== \"number\" || isNaN(v) || v < low || v > high) {\n        node.warn(`invalid reading: ${field} = ${JSON.stringify(v)}`);\n        return null;\n    }\n}\n\nlet temps = context.get(\"temps\") || [];\ntemps.push(p.temperature_c);\nif (temps.length > 5) temps.shift();\ncontext.set(\"temps\", temps);\nconst avgTemp = Number((temps.reduce((a, b) => a + b, 0) / temps.length).toFixed(2));\n\nlet status = \"NORMAL\";\nif (p.temperature_c >= 35) status = \"HIGH TEMPERATURE\";\nelse if (p.occupancy > MAX_OCCUPANCY) status = \"HIGH OCCUPANCY\";\nelse if (p.light_lux < 150 && p.occupancy > 0) status = \"LOW LIGHT\";\n\nconst result = {\n    application: \"SmartCampus\",\n    device: p.device,\n    status: status,\n    temperature_c: p.temperature_c,\n    avg_temperature_c: avgTemp,\n    occupancy: p.occupancy,\n    occupancy_pct: Number((p.occupancy / MAX_OCCUPANCY * 100).toFixed(1)),\n    light_lux: p.light_lux,\n};\nconst alert = status === \"NORMAL\" ? null : { payload: { status: \"WARNING\", reason: status, device: p.device } };\n\n// outputs: status, alert, temperature, occupancy, light, status text, avg temp\nreturn [\n    { payload: result },\n    alert,\n    { payload: p.temperature_c, topic: \"temperature\" },\n    { payload: p.occupancy },\n    { payload: p.light_lux },\n    { payload: status },\n    { payload: avgTemp },\n];\n",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 200,
        "wires": [
            [
                "exp9_status_out",
                "exp9_processed_debug"
            ],
            [
                "exp9_alert_out"
            ],
