        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "exp4_in",
        "type": "mqtt in",
        "z": "exp4_flow",
        "name": "soil raw",
        "topic": "ioe/exp4/soil/raw",
        "qos": "1",
        "datatype": "auto-detect",
        "broker": "exp4_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 120,
        "y": 200,
        "wires": [
            [
                "exp4_json",
                "exp4_raw_debug"
            ]
        ]
    },
    {
        "id": "exp4_json",
        "type": "json",
        "z": "exp4_flow",
        "name": "",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 290,
        "y": 200,
        "wires": [
            [
                "exp4_func"
            ]
        ]
    },
    {
        "id": "exp4_raw_debug",
        "type": "debug",
        "z": "exp4_flow",
        "name": "raw",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 290,
        "y": 120,
        "wires": []
    },
    {
        "id": "exp4_func",
        "type": "function",
        "z": "exp4_flow",
        "name": "edge filter",
        "func": "// edge filtering: drop invalid and redundant readings, alert below threshold\nconst THRESHOLD = 30;\nconst DEADBAND = 2;\nconst p = msg.payload;\nconst m = p.moisture;\n\nif (typeof m !== \"number\" || m < 0 || m > 100) {\n    node.warn(`invalid reading: ${JSON.stringify(p)}`);\n    return null;\n}\n\nconst alert = m < THRESHOLD;\nconst last = context.get(\"last\");\nif (last !== undefined && Math.abs(m - last) < DEADBAND && alert === context.get(\"lastAlert\")) {\n    return null; // redundant reading, not forwarded\n}\ncontext.set(\"last\", m);\ncontext.set(\"lastAlert\", alert);\n\nconst status = alert ? \"DRY - IRRIGATE\" : \"OK\";\nconst result = {\n    device: p.device,\n    moisture: m,\n    status: status,\n    alert: alert,\n    timestamp: Math.floor(Date.now() / 1000),\n};\n\n// outputs: processed (cloud), moisture value, status text\nreturn [\n    { payload: result },\n    { payload: m, topic: \"moisture\" },\n    { payload: status },\n];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 200,
        "wires": [
            [
                "exp4_cloud_out",
                "exp4_processed_debug"
            ],
            [
                "exp4_gauge",
                "exp4_chart"
            ],
            [
                "exp4_status_text"
            ]
        ]
    },
    {
        "id": "exp4_cloud_out",
        "type": "mqtt out",
        "z": "exp4_flow",
        "name": "aws iot",
        "topic": "ioe/exp4/soil/processed",
        "qos": "1",
        "retain": "false",
        "broker": "exp4_aws_broker",
        "x": 720,
        "y": 100,
        "wires": []
    },
    {
        "id": "exp4_processed_debug",
